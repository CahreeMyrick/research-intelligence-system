            {
              "title": "Protecting a Service with a Firewall (EWL)",
              "level": 4,
              "page_start": 21,
              "page_end": 22,
              "paragraphs": [
                {
                  "text": "wizard Firewall_Protection {",
                  "page": 21,
                  "position": 34
                },
                {
                  "text": "guard : self.isKindOf(Model!ao::ConnectionPoint) and",
                  "page": 21,
                  "position": 35
                },
                {
                  "text": "guard : self.isPublic() and not self.isProtected()",
                  "page": 21,
                  "position": 36
                },
                {
                  "text": "title : \"inserting a firewall for protecting \" + self.name",
                  "page": 21,
                  "position": 37
                },
                {
                  "text": "do { self.owningModel.insertFirewall(self) }",
                  "page": 21,
                  "position": 38
                },
                {
                  "text": "}",
                  "page": 21,
                  "position": 39
                },
                {
                  "text": "Source: Holmes, T.; Zdun, U.: Refactoring Architecture Models for Compliance with Custom Requirements, ACM/IEEE MODELS, 2018, 267-277, ACM",
                  "page": 21,
                  "position": 40
                }
              ],
              "subsections": []
            },
            {
              "title": "Establishing High Service Availability (EVL)",
              "level": 4,
              "page_start": 22,
              "page_end": 23,
              "paragraphs": [
                {
                  "text": "context High_Availability {",
                  "page": 22,
                  "position": 41
                },
                {
                  "text": "guard : self.isKindOf(Model!ao::ConnectionPoint) constraint C2_derived_from_R2 {",
                  "page": 22,
                  "position": 42
                },
                {
                  "text": "check : self.ha message : \"R2 is not met by \" + self.name fix {",
                  "page": 22,
                  "position": 43
                },
                {
                  "text": "title : \"new server instance with keepalived\" do {",
                  "page": 22,
                  "position": 44
                },
                {
                  "text": "var service : new Service(\"keepalived\"); … } } } }",
                  "page": 22,
                  "position": 45
                },
                {
